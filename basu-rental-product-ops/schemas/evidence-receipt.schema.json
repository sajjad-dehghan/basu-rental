{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "taskId",
    "claim",
    "evidence",
    "verifier",
    "verdict",
    "verifiedAt"
  ],
  "properties": {
    "receiptId": {
      "type": "string",
      "minLength": 3
    },
    "taskId": {
      "type": "string",
      "minLength": 3
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "observedAt"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "verifier": {
      "type": "string",
      "minLength": 2
    },
    "verdict": {
      "enum": ["pass", "fail", "inconclusive"]
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
