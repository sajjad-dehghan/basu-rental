{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Operations Provider Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultDryRun", "providers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "defaultDryRun": { "const": true },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "enabled", "baseUrl", "credentialEnvironmentVariable", "operations"],
        "properties": {
          "category": { "enum": ["development", "work_management", "workbook", "notification"] },
          "enabled": { "type": "boolean" },
          "baseUrl": { "type": "string", "format": "uri" },
          "credentialEnvironmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
