{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Development Operations OS Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "system", "project", "roles", "qualityGates", "executors", "sync", "policies"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "system": { "const": "open-development-operations-os" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "environments"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["local", "test", "staging", "production"] }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "boundary", "actorId", "may", "mustNot"],
        "properties": {
          "id": { "type": "string", "pattern": "^ENG-[0-9]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "boundary": { "type": "string", "minLength": 1 },
          "actorId": { "type": "string", "minLength": 2 },
          "may": { "$ref": "#/$defs/nonEmptyStrings" },
          "mustNot": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "qualityGates": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "ownerRole", "required", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^GATE-[A-Z0-9-]+$" },
          "domain": { "type": "string", "minLength": 1 },
          "ownerRole": { "type": "string", "pattern": "^ENG-[0-9]{2}$" },
          "required": { "type": "boolean" },
          "evidence": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "executors": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleId", "enabled", "implementation", "executable", "arguments", "workingDirectory", "timeoutMs", "environmentAllowlist", "isolation"],
        "properties": {
          "roleId": { "type": "string", "pattern": "^ENG-[0-9]{2}$" },
          "enabled": { "type": "boolean" },
          "implementation": { "const": "command-runner" },
          "executable": { "type": "string" },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "workingDirectory": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 },
          "environmentAllowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
          "isolation": { "const": "external-required" }
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "inbox", "outbox", "receipts", "requireSourceDigest"],
      "properties": {
        "mode": { "const": "versioned-contracts" },
        "inbox": { "const": ".development-os/inbox" },
        "outbox": { "const": ".development-os/outbox" },
        "receipts": { "const": ".development-os/receipts" },
        "requireSourceDigest": { "const": true }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDryRun", "requireIndependentVerification", "requireThreatModelForHighRisk", "requireHumanProductionApproval", "allowedPaths", "prohibitedPaths"],
      "properties": {
        "defaultDryRun": { "const": true },
        "requireIndependentVerification": { "const": true },
        "requireThreatModelForHighRisk": { "const": true },
        "requireHumanProductionApproval": { "const": true },
        "allowedPaths": { "$ref": "#/$defs/nonEmptyStrings" },
        "prohibitedPaths": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
