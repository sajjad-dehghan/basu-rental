  "resultContract": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://open-product-operations-os.local/schemas/product-agent-run.schema.json",
    "title": "Product Agent Run",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "taskId",
      "eventId",
      "roleId",
      "producerActorId",
      "status",
      "summary",
      "findings",
      "recommendations",
      "acceptanceCriteria",
      "impacts",
      "constraints",
      "nonFunctionalRequirements",
      "evidence",
      "knownRisks",
      "completedAt"
    ],
    "properties": {
      "schemaVersion": {
        "const": "1.0.0"
      },
      "taskId": {
        "type": "string",
        "minLength": 3
      },
      "eventId": {
        "type": "string",
        "minLength": 3
      },
      "roleId": {
        "type": "string",
        "pattern": "^RB-(?:0[1-9]|1[0-3])$"
      },
      "producerActorId": {
        "type": "string",
        "minLength": 2
      },
      "status": {
        "enum": [
          "completed",
          "blocked",
          "failed"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 5,
        "maxLength": 4000
      },
      "findings": {
        "$ref": "#/$defs/strings"
      },
      "recommendations": {
        "$ref": "#/$defs/strings"
      },
      "acceptanceCriteria": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "verification"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 5,
              "maxLength": 1000
            },
            "verification": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1000
            }
          }
        }
      },
      "impacts": {
        "type": "array",
        "maxItems": 30,
        "uniqueItems": true,
        "items": {
          "enum": [
            "architecture",
            "frontend",
            "accessibility",
            "backend",
            "api",
            "integration",
            "mobile",
            "desktop",
            "database",
            "storage",
            "cache",
            "messaging",
            "search",
            "data",
            "ai",
            "analytics",
            "security",
            "privacy",
            "identity",
            "compliance",
            "network",
            "infrastructure",
            "devops",
            "sre",
            "observability",
            "performance",
            "resilience",
            "cost",
            "seo",
            "documentation"
          ]
        }
      },
      "constraints": {
        "$ref": "#/$defs/strings"
      },
      "nonFunctionalRequirements": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "requirement",
            "verification"
          ],
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "requirement": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1000
            },
            "verification": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1000
            }
          }
        }
      },
      "evidence": {
        "$ref": "#/$defs/strings"
      },
      "knownRisks": {
        "$ref": "#/$defs/strings"
      },
      "feedbackNote": {
        "type": "object",
        "additionalProperties": false,
        "description": "One or two sentences on what this card taught, filed into the workspace feedback loop and reported to the product owner. Optional per card; the control surface says so when one is owed.",
        "required": [
          "learned"
        ],
        "properties": {
          "learned": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500,
            "description": "What you learned. What surprised you, what turned out to be wrong, what this revealed about the product — not a summary of what you did."
          },
          "saw": {
            "type": "string",
            "maxLength": 500,
            "description": "What you actually observed that led to it, rather than what you infer from it."
          }
        }
      },
      "decisionProposal": {
        "type": "object",
        "additionalProperties": false,
        "description": "A product-direction question prepared by the decision-brief role for the product owner. The control plane presents these exact options; it never chooses one.",
        "required": [
          "question",
          "options"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 5,
            "maxLength": 400
          },
          "context": {
            "type": "string",
            "maxLength": 2000
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "recommendedOption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "recommendationRationale": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "optionImpacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      },
      "canonicalRecords": {
        "type": "array",
        "maxItems": 200,
        "description": "Rows this role is committing to the canonical workbook as part of finishing its card. A role may only write the tabs it owns, may only set real columns, and may never set a protected field.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sheet",
            "key",
            "fields"
          ],
          "properties": {
            "sheet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "key": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        }
      },
      "writeBoundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowedPaths"
        ],
        "description": "Where this delivery needs to be able to write. Optional, and only meaningful from the role that authors the delivery contract. It may narrow the application's own policy and can never widen it.",
        "properties": {
          "allowedPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "rationale": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "completedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "$defs": {
      "strings": {
        "type": "array",
        "maxItems": 30,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "policy": {
    "preserveHumanProductAuthority": true,
    "noDirectRepositoryWrites": true,
    "noProductionActions": true,
    "noCredentialMaterial": true,
    "evidenceBeforeClaims": true,
    "qualificationThreshold": "Ask the owner only when the answer changes a material product choice, risk acceptance, irreversible action, sensitive access, or final acceptance. Read canonical state first; mechanical choices are not human questions.",
    "discoveryStopRule": "Stop when remaining uncertainty cannot change the next decision or safe reversible action. Record the unknown and a trigger for reopening instead of forcing completeness.",
    "smallestCompleteOutcome": "Produce only the smallest complete result inside this role and task. Do not expand adjacent scope or create speculative artifacts.",
    "retryBeforeRecordingAbsence": true
  },
  "reporting": {
    "proportionalDeliveryRule": "Match analysis and evidence depth to current impact. Low-risk reversible work should stay focused; cross-boundary work needs integration and rollback proof; sensitive, production, high-risk, or irreversible work receives specialist gates and human authority. Scope, truthfulness, credentials, evidence, and independence never weaken.",
    "complexityRule": "Recommend new process, abstraction, dependency, service, store, queue, extension point, gate, or artifact only when a present requirement or observed risk needs it. Check for no-build, repository reuse, standard or native capability, and installed capability before proposing a local build. Name the simpler alternative considered, why it is insufficient now, the ongoing cost, and the removal or expansion trigger. Hypothetical future reuse is not evidence.",
    "absenceRule": "A source you could not reach is not a source that says nothing. Retry a failed retrieval at least once before recording anything as absent, and if it still fails, record the failure — what you tried and what it returned — rather than the absence."
  }
}
