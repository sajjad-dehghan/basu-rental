{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-product-operations-os.local/schemas/product-agent-run.schema.json",
  "title": "Product Agent Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "eventId", "roleId", "producerActorId", "status", "summary", "findings", "recommendations", "acceptanceCriteria", "impacts", "constraints", "nonFunctionalRequirements", "evidence", "knownRisks", "completedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string", "minLength": 3 },
    "eventId": { "type": "string", "minLength": 3 },
    "roleId": { "type": "string", "pattern": "^RB-(?:0[1-9]|1[0-3])$" },
    "producerActorId": { "type": "string", "minLength": 2 },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "summary": { "type": "string", "minLength": 5, "maxLength": 4000 },
    "findings": { "$ref": "#/$defs/strings" },
    "recommendations": { "$ref": "#/$defs/strings" },
    "acceptanceCriteria": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "verification"],
        "properties": {
          "statement": { "type": "string", "minLength": 5, "maxLength": 1000 },
          "verification": { "type": "string", "minLength": 3, "maxLength": 1000 }
        }
      }
    },
    "impacts": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "enum": ["architecture", "frontend", "accessibility", "backend", "api", "integration", "mobile", "desktop", "database", "storage", "cache", "messaging", "search", "data", "ai", "analytics", "security", "privacy", "identity", "compliance", "network", "infrastructure", "devops", "sre", "observability", "performance", "resilience", "cost", "seo", "documentation"] }
    },
    "constraints": { "$ref": "#/$defs/strings" },
    "nonFunctionalRequirements": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "requirement", "verification"],
        "properties": {
          "domain": { "type": "string", "minLength": 1, "maxLength": 100 },
          "requirement": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "verification": { "type": "string", "minLength": 3, "maxLength": 1000 }
        }
      }
    },
    "evidence": { "$ref": "#/$defs/strings" },
    "knownRisks": { "$ref": "#/$defs/strings" },
    "feedbackNote": {
      "type": "object",
      "additionalProperties": false,
      "description": "One or two sentences on what this card taught, filed into the workspace feedback loop and reported to the product owner. Optional per card; the control surface says so when one is owed.",
      "required": ["learned"],
      "properties": {
        "learned": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "description": "What you learned. What surprised you, what turned out to be wrong, what this revealed about the product — not a summary of what you did."
        },
        "saw": {
          "type": "string",
          "maxLength": 500,
          "description": "What you actually observed that led to it, rather than what you infer from it."
        }
      }
    },
    "decisionProposal": {
      "type": "object",
      "additionalProperties": false,
      "description": "A product-direction question prepared by the decision-brief role for the product owner. The control plane presents these exact options; it never chooses one.",
      "required": ["question", "options"],
      "properties": {
        "question": { "type": "string", "minLength": 5, "maxLength": 400 },
        "context": { "type": "string", "maxLength": 2000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "recommendedOption": { "type": "string", "minLength": 1, "maxLength": 200 },
        "recommendationRationale": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "optionImpacts": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "canonicalRecords": {
      "type": "array",
      "maxItems": 200,
      "description": "Rows this role is committing to the canonical workbook as part of finishing its card. A role may only write the tabs it owns, may only set real columns, and may never set a protected field.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheet", "key", "fields"],
        "properties": {
          "sheet": { "type": "string", "minLength": 1, "maxLength": 60 },
          "key": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "fields": {
            "type": "object",
            "additionalProperties": { "type": "string", "maxLength": 4000 }
          }
        }
      }
    },
    "writeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths"],
      "description": "Where this delivery needs to be able to write. Optional, and only meaningful from the role that authors the delivery contract. It may narrow the application's own policy and can never widen it.",
      "properties": {
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "rationale": { "type": "string", "maxLength": 500 }
      }
    },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "strings": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
  }
}
