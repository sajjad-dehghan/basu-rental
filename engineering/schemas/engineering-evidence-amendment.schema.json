{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Evidence Amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "amendmentId", "planId", "workstreamId", "ownerRole", "ownerActorId",
    "recordedByRole", "recordedByActorId", "target", "corrections", "reason", "evidence",
    "status", "verificationRequiredByRole", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "amendmentId": { "type": "string", "pattern": "^AMEND-[A-F0-9]{12}$" },
    "planId": { "type": "string", "pattern": "^ENGPLAN-[A-Za-z0-9._-]+$" },
    "workstreamId": { "type": "string", "pattern": "^WS-[0-9]{2}$" },
    "ownerRole": { "type": "string", "pattern": "^ENG-[0-9]{2}$" },
    "ownerActorId": { "type": "string", "minLength": 2 },
    "recordedByRole": { "const": "ENG-01" },
    "recordedByActorId": { "type": "string", "minLength": 2 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "artifactSha256"],
      "properties": {
        "artifactPath": { "type": "string", "pattern": "^\\.development-os/(runs|evidence)/[^.][A-Za-z0-9._/-]*$" },
        "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "priorValue", "correctedValue"],
        "properties": {
          "field": { "type": "string", "pattern": "^/", "minLength": 2 },
          "priorValue": {},
          "correctedValue": {}
        },
        "allOf": [{
          "if": {
            "properties": { "field": { "const": "/changedComponents" } },
            "required": ["field"]
          },
          "then": {
            "properties": {
              "priorValue": { "$ref": "#/$defs/componentList" },
              "correctedValue": { "$ref": "#/$defs/componentList" }
            }
          },
          "else": {
            "properties": {
              "priorValue": { "$ref": "#/$defs/scalar" },
              "correctedValue": { "$ref": "#/$defs/scalar" }
            }
          }
        }]
      }
    },
    "reason": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference"],
        "properties": {
          "reference": { "type": "string", "minLength": 3, "maxLength": 500 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "status": { "const": "pending_independent_verification" },
    "verificationRequiredByRole": { "const": "ENG-15" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "componentList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
